---
config:
  htmlLabels: false
  theme: base
  themeCSS: |
    g[id*="flowchart-podIcon-"] {
      translate: 0 -81.5px;
    }
  themeVariables:
    fontFamily: Arial, sans-serif
    primaryColor: '#eff6ff'
    primaryTextColor: '#0f172a'
    primaryBorderColor: '#326ce5'
    lineColor: '#475569'
    clusterBkg: '#f8fafc'
    clusterBorder: '#94a3b8'
    edgeLabelBackground: '#ffffff'
  flowchart:
    htmlLabels: false
    curve: linear
    diagramPadding: 56
---
%% Source: test-deployment.yaml. Icons: kubernetes/community (Apache-2.0).
%% Image paths are relative to this file; serve the icon assets when rendering.
%% The exported SVG embeds the icons so it can be viewed independently.
%% Source caveat: template.spec is duplicated; OnFailure is invalid for a Deployment.
%% This diagram shows the Deployment, Pod and container containment.
%% The Pod name is an illustrative runtime name supplied for this diagram.
%% Move only the Pod badge artwork onto the upper border; keep the container inside.
flowchart LR
    deployment@{ img: "../../community/icons/svg/resources/labeled/deploy.svg", label: "Deployment: test", pos: "b", h: 88, constraint: "on" }

    subgraph pod[" "]
        direction TB
        podIcon@{ img: "../../community/icons/svg/resources/labeled/pod.svg", label: "Pod: test-1234567890-abcde", pos: "b", h: 88, constraint: "on" }
        container["コンテナ<br/>name: test<br/>image: nginx:latest"]
        podIcon ~~~ container
    end

    deployment -->|管理| pod

    classDef containerStyle fill:#eff6ff,stroke:#326ce5,stroke-width:1.5px,color:#0f172a
    class container containerStyle
