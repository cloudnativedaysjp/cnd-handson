---
config:
  htmlLabels: false
  theme: base
  themeCSS: |
    g[id*="flowchart-deploymentIcon-"] {
      translate: 0 -79px;
    }
  themeVariables:
    fontFamily: Arial, sans-serif
    primaryColor: '#eff6ff'
    primaryTextColor: '#0f172a'
    primaryBorderColor: '#326ce5'
    lineColor: '#475569'
    clusterBkg: '#f8fafc'
    clusterBorder: '#94a3b8'
    edgeLabelBackground: '#ffffff'
  flowchart:
    htmlLabels: false
    curve: linear
    diagramPadding: 56
    subGraphTitleMargin:
      top: 10
      bottom: 40
---
%% Based on ../test-service/test-service.mmd, with a conceptual Gateway API entry point.
%% Icons: kubernetes/community (Apache-2.0).
%% Image paths are relative to this file; serve the icon assets when rendering.
%% The exported SVG embeds the icons so it can be viewed independently.
%% The Deployment frame groups its managed Pods for a simplified overview.
%% Align the Deployment frame's upper border with the center of its badge.
flowchart LR
    client["クライアント"]

    %% Reserve space above the Deployment badge so it stays inside the cluster.
    subgraph cluster["クラスター"]
        direction LR
        gateway["Gateway API"]
        service@{ img: "../../community/icons/svg/resources/labeled/svc.svg", label: "Service: test-service", pos: "b", h: 88, constraint: "on" }

        subgraph deployment[" "]
            direction TB
            deploymentIcon@{ img: "../../community/icons/svg/resources/labeled/deploy.svg", label: "Deployment: test", pos: "b", h: 88, constraint: "on" }
            pod@{ img: "../../community/icons/svg/resources/labeled/pod.svg", h: 88, constraint: "on" }
            pod2@{ img: "../../community/icons/svg/resources/labeled/pod.svg", h: 88, constraint: "on" }
        end

        gateway -->|通信| service
        service -->|通信| pod
        service -->|通信| pod2
    end

    client -->|通信| gateway

    style cluster fill:#ffffff,stroke:#94a3b8,stroke-width:1.5px
    %% Remove the 50px title margin from this frame while keeping its bottom edge fixed.
    style deployment height:465px,translate:0 50px
