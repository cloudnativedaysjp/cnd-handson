---
config:
  htmlLabels: false
  theme: base
  themeCSS: |
    g[id*="flowchart-podIcon-"],
    g[id*="flowchart-podIcon2-"] {
      translate: 0 -81.5px;
    }
  themeVariables:
    fontFamily: Arial, sans-serif
    primaryColor: '#eff6ff'
    primaryTextColor: '#0f172a'
    primaryBorderColor: '#326ce5'
    lineColor: '#475569'
    clusterBkg: '#f8fafc'
    clusterBorder: '#94a3b8'
    edgeLabelBackground: '#ffffff'
  flowchart:
    htmlLabels: false
    curve: linear
    diagramPadding: 56
---
%% Based on ../test-deployment/test-deployment.yaml with replicas: 2.
%% Icons: kubernetes/community (Apache-2.0).
%% Image paths are relative to this file; serve the icon assets when rendering.
%% The exported SVG embeds the icons so it can be viewed independently.
%% This diagram shows the Deployment, Pods and container containment.
%% The Pod names are illustrative runtime names supplied for this diagram.
%% Move only the Pod badge artwork onto the upper border; keep the containers inside.
flowchart LR
    deployment@{ img: "../../community/icons/svg/resources/labeled/deploy.svg", label: "Deployment: test", pos: "b", h: 88, constraint: "on" }

    subgraph pod[" "]
        direction TB
        podIcon@{ img: "../../community/icons/svg/resources/labeled/pod.svg", label: "Pod:<br/>test-1234567890-abcde", pos: "b", h: 88, constraint: "on" }
        container["コンテナ<br/>name: test<br/>image: nginx:latest"]
        podIcon ~~~ container
    end

    subgraph pod2[" "]
        direction TB
        podIcon2@{ img: "../../community/icons/svg/resources/labeled/pod.svg", label: "Pod:<br/>test-1234567890-efghi", pos: "b", h: 88, constraint: "on" }
        container2["コンテナ<br/>name: test<br/>image: nginx:latest"]
        podIcon2 ~~~ container2
    end

    deployment -->|管理| pod
    deployment -->|管理| pod2

    classDef containerStyle fill:#eff6ff,stroke:#326ce5,stroke-width:1.5px,color:#0f172a
    class container,container2 containerStyle
